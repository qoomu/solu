{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "downlevelIteration": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "react/experimental"
    ],
    "jsx": "preserve",
    "outDir": "./dist",
    "composite": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "./src",
    "./waku.config.ts",
    ".next/types/**/*.ts"
  ],
  "extends": "expo/tsconfig.base"
}
